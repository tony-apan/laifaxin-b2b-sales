#!/usr/bin/env bash
# 推送前自检：再跑一遍 tools/preflight.sh；失败则拒绝推送。
# 应急跳过：SKIP_PREFLIGHT=1 git push ...
set -u
if [ "${SKIP_PREFLIGHT:-0}" = "1" ]; then
  echo "⚠️  已跳过推送前自检（SKIP_PREFLIGHT=1）"
  exit 0
fi
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/tools/preflight.sh" ]; then
  echo "⚠️  未找到 tools/preflight.sh，跳过推送前自检"
  exit 0
fi
cd "$ROOT" || exit 1
echo "🔎 推送前自检：bash tools/preflight.sh"
if bash tools/preflight.sh; then
  echo "✅ 推送前自检通过，允许推送"
  exit 0
else
  echo "❌ 推送前自检失败，已阻止本次推送；修好后重试，或 SKIP_PREFLIGHT=1 应急跳过。"
  exit 1
fi
