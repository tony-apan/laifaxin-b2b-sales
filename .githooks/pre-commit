#!/usr/bin/env bash
# 提交前自检：跑 tools/preflight.sh；失败则拒绝本次提交。
# 应急跳过：SKIP_PREFLIGHT=1 git commit ...
set -u
if [ "${SKIP_PREFLIGHT:-0}" = "1" ]; then
  echo "⚠️  已跳过提交前自检（SKIP_PREFLIGHT=1）"
  exit 0
fi
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] || [ ! -f "$ROOT/tools/preflight.sh" ]; then
  echo "⚠️  未找到 tools/preflight.sh，跳过提交前自检"
  exit 0
fi
cd "$ROOT" || exit 1
echo "🔎 提交前自检：bash tools/preflight.sh"
if bash tools/preflight.sh; then
  echo "✅ 提交前自检通过，允许提交"
  exit 0
else
  echo "❌ 提交前自检失败，已阻止本次提交；修好后重试，或 SKIP_PREFLIGHT=1 应急跳过。"
  exit 1
fi
